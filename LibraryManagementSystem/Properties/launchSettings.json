        "ASPNETCORE_ENVIRONMENT": "Development",
        "BranchSettings__DefaultBranchCode": "CAS"
      }
    },
    "Branch-PAL": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
