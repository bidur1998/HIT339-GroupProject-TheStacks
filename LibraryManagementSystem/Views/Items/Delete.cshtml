@model Item
@{
    ViewData["Title"] = "Delete item";
}

<h1>Delete "@Model.Name"?</h1>
<p>This can't be undone. Items currently on loan, or with loan/reservation history, can't be deleted &mdash; set them to Destroyed instead.</p>

<table>
    <tbody>
        <tr><th>Type</th><td>@Model.ItemType</td></tr>
        <tr><th>Library code</th><td>@Model.LibraryCode</td></tr>
        <tr><th>Status</th><td>@Model.Status</td></tr>
    </tbody>
</table>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <div class="actions-row">
        <button type="submit" class="btn btn-danger">Yes, delete it</button>
        <a class="btn btn-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
