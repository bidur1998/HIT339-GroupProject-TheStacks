@model Borrower
@{
    ViewData["Title"] = Model.FullName;
    var activeHolds = Model.Reservations.Where(r => r.IsActive).OrderBy(r => r.CreatedAt).ToList();
}

<h1>@Model.FullName</h1>
<table>
    <tbody>
        <tr><th>Library card</th><td>@(Model.CardNumber ?? "—") @(string.IsNullOrEmpty(Model.PinHash) ? "(no kiosk PIN set)" : "")</td></tr>
        <tr><th>Email</th><td>@Model.Email</td></tr>
        <tr><th>Phone</th><td>@(Model.PhoneNumber ?? "—")</td></tr>
        <tr><th>Address</th><td>@(Model.Address ?? "—")</td></tr>
        <tr><th>Home branch</th><td>@(Model.HomeBranch?.Name ?? "—")</td></tr>
        <tr><th>Notifications</th><td>@Model.NotificationPreference</td></tr>
        <tr><th>Registered</th><td>@Model.DateRegistered.ToString("d MMM yyyy")</td></tr>
        <tr><th>Outstanding fines</th><td>@($"${Model.OutstandingFines:0.00}")</td></tr>
    </tbody>
</table>

<h2 style="margin-top:2rem;">Loan history</h2>
@if (!Model.Loans.Any())
{
    <p>No loans on record.</p>
}
else
{
    <div class="table-scroll">
        <table>
            <thead><tr><th>Item</th><th>Borrowed</th><th>Due</th><th>Returned</th><th>Fine</th><th></th></tr></thead>
            <tbody>
                @foreach (var loan in Model.Loans.OrderByDescending(l => l.BorrowedDate))
                {
                    <tr>
                        <td>@loan.Item.Name</td>
                        <td>@loan.BorrowedDate.ToString("d MMM yyyy") @(loan.BorrowChannel == "Kiosk" ? "(kiosk)" : "")</td>
                        <td>@loan.DueDate.ToString("d MMM yyyy")</td>
                        <td>@(loan.ReturnedDate?.ToString("d MMM yyyy") ?? "Not yet returned")</td>
                        <td>
                            @if (loan.FineAmount is > 0)
                            {
                                @($"${loan.FineAmount:0.00}")
                                @if (loan.FinePaid)
                                {
                                    <span class="badge badge-available">Paid @loan.FinePaidDate?.ToString("d MMM")</span>
                                }
                                else
                                {
                                    <span class="badge badge-overdue">Unpaid</span>
                                }
                            }
                            else
                            {
                                @("—")
                            }
                        </td>
                        <td>
                            @if (loan.FineAmount is > 0 && !loan.FinePaid)
                            {
                                <form asp-action="PayFine" method="post" class="inline-form">
                                    <input type="hidden" name="loanId" value="@loan.Id" />
                                    <input type="hidden" name="borrowerId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary">Record payment</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 style="margin-top:2rem;">Reservations</h2>
@if (!activeHolds.Any())
{
    <p>No active holds.</p>
}
else
{
    <div class="table-scroll">
        <table>
            <thead><tr><th>Item</th><th>Placed</th><th>Status</th><th>Pick up at</th></tr></thead>
            <tbody>
                @foreach (var r in activeHolds)
                {
                    <tr>
                        <td>@r.Item.Name</td>
                        <td>@r.CreatedAt.ToString("d MMM yyyy")</td>
                        <td>@r.Status @(r.HoldExpiresAt.HasValue ? $"(until {r.HoldExpiresAt:d MMM})" : "")</td>
                        <td>@r.PickupBranch?.Name</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="actions-row">
    <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit / set PIN</a>
    <a class="btn btn-secondary" asp-action="Index">Back to borrowers</a>
</div>
